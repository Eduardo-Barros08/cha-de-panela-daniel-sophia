# Banco de dados (SQLite local). Para Supabase/Postgres, troque a URL e o provider no schema.
DATABASE_URL="file:./dev.db"

# Senha inicial dos admins (criada no seed; troque no primeiro acesso)
ADMIN_INITIAL_PASSWORD=troque-esta-senha

# E-mails dos noivos (admins)
ADMIN1_EMAIL=daniel@admin.local
ADMIN2_EMAIL=sophia@admin.local

# Segredo para assinar a sessão administrativa (use 64+ caracteres aleatórios em produção)
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# URL pública do site (usada em links de gerenciamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
